# Copy to .env and fill in. .env is gitignored; this file must stay free of
# real tokens and secrets.
#
#   cp env.example .env

# --- Server ------------------------------------------------------------------

GOGIG_HOST=0.0.0.0
GOGIG_PORT=8000

# http  — MCP Inspector, Claude Code, remote connectors
# stdio — Claude Desktop launching this server itself
GOGIG_TRANSPORT=http

# The gogig-api-nestjs instance the tools read from.
GOGIG_API_BASE_URL=http://localhost:8080


# --- Credential fallback -----------------------------------------------------

# A bearer token used ONLY when the request carries no credential of its own —
# which is the case over stdio, where there are no HTTP headers. Accepted with
# or without the "Bearer " prefix.
#
# WARNING: this bypasses the login. Leave it EMPTY whenever the server is
# reachable from outside this machine (a tunnel, a deployment), or anyone with
# the URL reads gOGig data as whoever this token belongs to.
GOGIG_TOKEN=


# --- OAuth login -------------------------------------------------------------

# Sends connecting clients to a login page instead of expecting a token.
GOGIG_AUTH_ENABLED=false

# Where clients actually reach this server. The OAuth metadata and the login
# page are advertised under it, so with a tunnel in front this must be the
# public HTTPS URL, not localhost.
GOGIG_PUBLIC_URL=http://localhost:8000

# How THIS SERVER authenticates to gOGig's login API: the AuthClient row.
#   INSERT INTO AuthClient (clientId, name, secret_key, allowedUrls)
#   VALUES ('mcp_gogig', 'gogig-mcp-server', '<long random secret>', 'http://localhost:8000');
GOGIG_AUTH_CLIENT_ID=mcp_gogig

# Sent as the Origin header to gOGig. Must appear in that row's allowedUrls or
# every login is refused — keep it in step with GOGIG_PUBLIC_URL.
GOGIG_AUTH_ORIGIN=http://localhost:8000

# How an MCP CLIENT identifies itself to this server — a different thing from
# GOGIG_AUTH_CLIENT_ID above, checked by a different system.
#
# Blank: clients register themselves (DCR). Simplest, but registrations are
# held in memory, so a restart turns a registered client away until it
# registers again.
# Set: a client configured with this id by hand keeps working across restarts.
GOGIG_OAUTH_CLIENT_ID=

# Allowlist for that fixed client's redirect_uri. The authorization code is
# delivered to this address, so add entries deliberately rather than widening
# it. Defaults to the claude.ai and MCP Inspector callbacks.
# GOGIG_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:6274/oauth/callback
